NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=false
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
RATE_LIMIT_MAX_KEYS=10000
GMAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_CLOUD_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-application-credentials.json
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
GEOFENCE_RADIUS_M=200
GEOFENCE_MAX_ACCURACY_M=100
GEOFENCE_REQUIRE_ACCURACY=false
GEOFENCE_REJECT_MOCKED=true
EVIDENCE_REQUIRED_FOR_ACTIVITY=true
EVIDENCE_REQUIRED_FOR_VISIT_WITHOUT_ACTIVITIES=true
EVIDENCE_MAX_BYTES=6291456
EVIDENCE_MAX_PER_ITEM=10
EVIDENCE_MAX_PER_ACTIVITY=3
EVIDENCE_MAX_ACCURACY_M=100
